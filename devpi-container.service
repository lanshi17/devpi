[Unit]
Description=devpi Docker Container Service
After=network.target

[Service]
# docker run -d 会立刻退出, 必须用 oneshot, 否则 Restart=always 会无限重建容器。
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=0
ExecStartPre=-/usr/bin/docker stop -t 30 devpi-container
ExecStartPre=-/usr/bin/docker rm devpi-container
ExecStart=/usr/bin/docker run -d --name devpi-container \
  -p 127.0.0.1:3141:3141 \
  -v /mnt/data/Projects/Tools/Utilities/devpi/data:/root/.devpi/server \
  --log-opt max-size=10m \
  --log-opt max-file=3 \
  --restart=always \
  devpi-image:latest
ExecStop=/usr/bin/docker stop -t 30 devpi-container

[Install]
WantedBy=default.target
