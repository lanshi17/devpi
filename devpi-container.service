[Unit]
Description=devpi Podman Container Service
After=network.target

[Service]
Type=simple
Restart=always
RestartSec=30
TimeoutStartSec=0
ExecStartPre=-/usr/bin/podman stop devpi-container
ExecStartPre=-/usr/bin/podman rm devpi-container
ExecStart=/usr/bin/podman run --name devpi-container \
  -p 3141:3141 \
  -v /home/yangzs/devpi/data:/root/.devpi/server:z \
  devpi-image
ExecStop=/usr/bin/podman stop devpi-container

[Install]
WantedBy=default.target
